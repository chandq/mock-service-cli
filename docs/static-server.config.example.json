{
  "open": false,
  "browser": "default",
  "watch": {
    "ignore": ["**/node_modules/**", "**/.git/**"],
    "delay": 100,
    "fullReload": false,
    "depth": 3
  },
  "injectTag": "body",
  "mounts": [
    {
      "path": "/",
      "directory": "./public",
      "spaFallback": "/index.html",
      "proxy": {
        "/api": {
          "target": "http://127.0.0.1:3000",
          "rewrite": false,
          "requestHeaders": {
            "X-Route-Environment": "local"
          }
        }
      },
      "cors": true,
      "headers": {
        "Cache-Control": "no-store"
      },
      "requestHeaders": {
        "X-Application": "shell"
      },
      "secure": false,
      "accessLog": {
        "success": "./logs/root-success.jsonl",
        "failure": "./logs/root-failure.jsonl"
      }
    },
    {
      "path": "/vendor",
      "directory": "../project1",
      "proxy": {
        "/vendor/api": {
          "target": "http://127.0.0.1:3100",
          "rewrite": true,
          "requestHeaders": {
            "X-Route-Environment": "local"
          }
        }
      },
      "cors": false,
      "headers": {
        "X-Vendor-App": "enabled"
      },
      "requestHeaders": {
        "X-Application": "vendor"
      },
      "secure": false
    }
  ],
  "https": {
    "cert": "./certs/local-cert.pem",
    "key": "./certs/local-key.pem"
  }
}
